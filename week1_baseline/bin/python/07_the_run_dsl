#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
STEP_DIR="$REPO_ROOT/week1_baseline/python/07_the_run_dsl"
PYTHON="$REPO_ROOT/week1_baseline/python/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "Shared Python environment not found: $PYTHON" >&2
  exit 1
fi

cd "$STEP_DIR"
exec "$PYTHON" examples/example.py
